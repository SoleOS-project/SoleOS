#!/bin/bash
# =====================================================================
#  SoleOS – outils du système installé
#  © 2026 GDH – créé par Giuseppe D'Arco – LicenseRef-SoleOS
#
#  Le disque contient : démarrage · système A · système B · copie d'origine
#  (« usine ») · données. SoleOS tourne sur A ou B, en lecture seule.
#
#    flashos-systeme etat                  état des emplacements
#    flashos-systeme maj                   prépare la mise à jour dans l'autre emplacement
#    flashos-systeme confirmer             valide le démarrage en cours (après une mise à jour)
#    flashos-systeme preparer-reparation   redémarrage suivant : outil de réparation
#    flashos-systeme ecrire-grub <dossier> <uuid A> <uuid B> <uuid usine>
#    flashos-systeme heure-etat | fuseau <Zone/Ville> | heure-auto oui|non | heure-regler "AAAA-MM-JJ HH:MM"
#    flashos-systeme langue <fr|en|it|es|de|zh> <clavier> <variante|->  |  langue-appliquer (au démarrage)
# =====================================================================
set -uo pipefail
export LC_ALL=C PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Messages dans la langue choisie pour l'ordinateur (gettext, domaine « flashos ») :
# t "texte français" [nom valeur]… remplace aussi {nom} par la valeur
FLASHOS_LANGUE_CODE="${FLASHOS_LANGUE_CODE:-$(cat /run/flashos/langue 2>/dev/null || true)}"
t() {
  local m="$1" loc="" lang=""; shift
  case "$FLASHOS_LANGUE_CODE" in
    en) loc=en_US.UTF-8 lang=en ;; it) loc=it_IT.UTF-8 lang=it ;; es) loc=es_ES.UTF-8 lang=es ;;
    de) loc=de_DE.UTF-8 lang=de ;; zh) loc=zh_CN.UTF-8 lang=zh_CN ;;
  esac
  if [ -n "$loc" ] && command -v gettext >/dev/null 2>&1; then
    m="$(LC_ALL="$loc" LANGUAGE="$lang" TEXTDOMAIN=flashos gettext -- "$m" 2>/dev/null || printf '%s' "$m")"
  fi
  while [ $# -ge 2 ]; do m="${m//\{$1\}/$2}"; shift 2; done
  printf '%s' "$m"
}

DEMARRAGE="${FLASHOS_DEMARRAGE:-/flashos/demarrage}"
ENV_GRUB="$DEMARRAGE/grub/grubenv"
JOURNAL_MAJ=/home/.flashos/maj.log
[ -d /home/.flashos ] || JOURNAL_MAJ=/var/log/flashos-maj.log
ETAT=/run/flashos
# panic=10 : si une version ne démarre pas, l'ordinateur redémarre seul (et revient à la bonne)
# plymouth.use-legacy-input : le code se tape via la console, où Verr Num est allumé d'office
LIGNE_NOYAU="quiet splash loglevel=3 vt.global_cursor_default=0 panic=10 plymouth.use-legacy-input preempt=full"

dire() { echo "$*"; echo "$(date '+%F %T') $*" >> "$JOURNAL_MAJ" 2>/dev/null; }

slot_actif() { sed -n 's/.*flashos\.slot=\([AB]\).*/\1/p' /proc/cmdline; }
autre_slot() { [ "$1" = A ] && echo B || echo A; }

# Disque qui porte le système en cours
disque_systeme() {
  local src
  src="$(findmnt -no SOURCE /run/flashos/bas 2>/dev/null || findmnt -no SOURCE / 2>/dev/null)"
  lsblk -no PKNAME "$src" 2>/dev/null | head -1
}

# Partition du disque portant ce nom (FLASHOS-A, FLASHOS-B, …)
partition_nommee() {  # <disque> <nom>
  lsblk -lnpo NAME,PARTLABEL "/dev/${1#/dev/}" 2>/dev/null | awk -v n="$2" '$2==n {print $1; exit}'
}

valeur_env() { grub-editenv "$ENV_GRUB" list 2>/dev/null | sed -n "s/^$1=//p"; }

# Les liens /boot/vmlinuz et /boot/initrd.img désignent toujours le noyau le plus récent
liens_noyau() {  # <racine>
  local r="$1" v
  v="$(ls "$r"/boot/vmlinuz-* 2>/dev/null | sed 's#.*/vmlinuz-##' | sort -V | tail -1)"
  [ -n "$v" ] || return 1
  ln -sf "vmlinuz-$v" "$r/boot/vmlinuz"
  [ -f "$r/boot/initrd.img-$v" ] && ln -sf "initrd.img-$v" "$r/boot/initrd.img"
  return 0
}

ecrire_grub() {  # <dossier grub> <uuid A> <uuid B> <uuid usine> [dossier de la copie d'origine]
  local d="$1" ua="$2" ub="$3" uu="$4" cu="${5:-flashos-usine}"
  # Menu verrouillé (recommandation ANSSI) : on peut choisir une entrée (Échap), mais pas
  # modifier la ligne de démarrage ni ouvrir la console GRUB. Mot de passe tiré au hasard
  # et jamais enregistré : personne ne peut s'en servir.
  local hasard empreinte
  hasard="$(head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9')"
  empreinte="$(printf '%s\n%s\n' "$hasard" "$hasard" | grub-mkpasswd-pbkdf2 2>/dev/null | sed -n 's/.* is //p')"
  hasard=""
  cat > "$d/grub.cfg" <<FIN
# SoleOS – menu de démarrage (généré automatiquement)
# Échap au démarrage : menu de secours (autre version, réparation).
set timeout_style=hidden
set timeout=1
# Pas d'image de fond : son décodage par GRUB coûtait plusieurs secondes à chaque démarrage
# (le logo SoleOS s'affiche juste après, avec le système).
insmod part_gpt
insmod ext2
insmod all_video
set gfxpayload=keep

set superusers="flashos"
$( [ -n "$empreinte" ] && echo "password_pbkdf2 flashos $empreinte" )

set default=A
if [ -s \$prefix/grubenv ]; then load_env -f \$prefix/grubenv; fi
if [ -n "\${next_entry}" ]; then
  # Essai d'une mise à jour (ou réparation) : une seule fois
  set default="\${next_entry}"
  set next_entry=
  save_env -f \$prefix/grubenv next_entry
elif [ -n "\${saved_entry}" ]; then
  set default="\${saved_entry}"
fi

menuentry "SoleOS" --id A --unrestricted {
  search --no-floppy --fs-uuid --set=root $ua
  linux /boot/vmlinuz root=UUID=$ua ro $LIGNE_NOYAU flashos.slot=A
  initrd /boot/initrd.img
}
menuentry "$(t "SoleOS (autre version)")" --id B --unrestricted {
  search --no-floppy --fs-uuid --set=root $ub
  linux /boot/vmlinuz root=UUID=$ub ro $LIGNE_NOYAU flashos.slot=B
  initrd /boot/initrd.img
}
menuentry "$(t "Réparer ou réinitialiser SoleOS")" --id reparer --unrestricted {
  search --no-floppy --fs-uuid --set=root $uu
  linux /$cu/vmlinuz boot=live components quiet splash live-media=/dev/disk/by-uuid/$uu live-media-path=/$cu $(options_langue_live) username=soleos user-fullname=SoleOS hostname=soleos flashos.reparer
  initrd /$cu/initrd.img
}
FIN
}

# ---------------------------------------------------------------------
#  Langue et clavier (choix de la clé USB, ou Réglages → Langue et clavier).
#  Le système est en lecture seule : le choix est gardé sur la partition de démarrage
#  et réappliqué à chaque démarrage (langue-appliquer), avant la saisie du code.
# ---------------------------------------------------------------------
FICHIER_LANGUE="$DEMARRAGE/flashos/langue"
locale_de() {  # <code> → locale du système
  case "$1" in
    fr) echo fr_FR.UTF-8 ;; en) echo en_US.UTF-8 ;; it) echo it_IT.UTF-8 ;;
    es) echo es_ES.UTF-8 ;; de) echo de_DE.UTF-8 ;; zh) echo zh_CN.UTF-8 ;; *) return 1 ;;
  esac
}
language_de() {  # <code> → LANGUAGE
  case "$1" in zh) echo zh_CN:zh ;; *) echo "$(locale_de "$1" | cut -d. -f1):$1" ;; esac
}
# Écrit le choix dans le système en cours (/run/flashos/langue, /etc/default/locale,
# /etc/default/keyboard, clavier de la console), sans le garder
langue_ecrire() {  # <code> <disposition> <variante>
  local code="$1" disp="$2" var="$3" loc ancien
  loc="$(locale_de "$code")" || return 1
  mkdir -p -m 755 /run/flashos
  printf '%s\n' "$code" > /run/flashos/langue; chmod 644 /run/flashos/langue
  printf 'LANG=%s\nLANGUAGE=%s\n' "$loc" "$(language_de "$code")" > /etc/default/locale
  ancien="$(grep -E '^XKB(LAYOUT|VARIANT)=' /etc/default/keyboard 2>/dev/null | tr -d '"' | tr '\n' ' ')"
  # (variante SoleOS « < > avec AltGr + W / X » : seulement dans la session ; console en AZERTY normal)
  local cvar="$var"; [ "$var" = flashos_ltgt ] && cvar=""
  printf 'XKBMODEL="pc105"\nXKBLAYOUT="%s"\nXKBVARIANT="%s"\nXKBOPTIONS=""\nBACKSPACE="guess"\n' "$disp" "$cvar" > /etc/default/keyboard
  # Clavier de la console et de l'écran de démarrage (saisie du code) : tout de suite
  if [ "$ancien" != "XKBLAYOUT=$disp XKBVARIANT=$cvar " ] && command -v setupcon >/dev/null 2>&1; then
    setupcon -k --force >/dev/null 2>&1 || true
  fi
  # Wi-Fi : règles du pays (canaux et puissance permis), déduit du clavier (fr → FR, be → BE,
  # gb → GB, us → US…). Sans pays, la carte reste en mode « monde » : moins de canaux, plus lent.
  local pays=""
  case "$disp" in cn) pays=CN ;; latam) pays="" ;; [a-z][a-z]) pays="$(printf '%s' "$disp" | tr a-z A-Z)" ;; esac
  if [ -n "$pays" ]; then
    printf 'options cfg80211 ieee80211_regdom=%s\n' "$pays" > /etc/modprobe.d/flashos-pays.conf 2>/dev/null
    command -v iw >/dev/null 2>&1 && iw reg set "$pays" >/dev/null 2>&1
  fi
  # Navigateur : page d'accueil et favoris de la langue (pour les profils créés ensuite)
  local p="/usr/share/flashos/navigateur/initial_preferences.$code" c
  if [ -f "$p" ]; then
    for c in /usr/lib/chromium/initial_preferences /etc/chromium/initial_preferences /etc/chromium/master_preferences; do
      [ -e "$c" ] && cp "$p" "$c" 2>/dev/null
    done
  fi
  true
}
langue_choisir() {  # <code> <disposition> <variante|->
  local code="$1" disp="$2" var="${3:-}"
  [ "$var" = "-" ] && var=""
  locale_de "$code" >/dev/null || { t "Langue inconnue." >&2; echo >&2; exit 1; }
  { [[ "$disp" =~ ^[a-z]{2,8}$ ]] && [[ "$var" =~ ^[a-z0-9_]{0,20}$ ]]; } || { t "Clavier inconnu." >&2; echo >&2; exit 1; }
  langue_ecrire "$code" "$disp" "$var"
  if [ -d "$DEMARRAGE" ] && grep -q "flashos\.slot=" /proc/cmdline 2>/dev/null; then
    mkdir -p "$DEMARRAGE/flashos"; chmod 700 "$DEMARRAGE/flashos"
    printf 'LANGUE=%s\nCLAVIER=%s\nVARIANTE=%s\n' "$code" "$disp" "$var" > "$FICHIER_LANGUE"; chmod 600 "$FICHIER_LANGUE"
    # Menu de démarrage (Échap) et outil de réparation dans la nouvelle langue
    FLASHOS_LANGUE_CODE="$code" regenerer_grub
  fi
  true
}
langue_appliquer() {  # au démarrage
  local code=fr disp="" var=""
  if [ -f "$FICHIER_LANGUE" ]; then
    code="$(sed -n 's/^LANGUE=//p' "$FICHIER_LANGUE" | tail -1)"
    disp="$(sed -n 's/^CLAVIER=//p' "$FICHIER_LANGUE" | tail -1)"
    var="$(sed -n 's/^VARIANTE=//p' "$FICHIER_LANGUE" | tail -1)"
    locale_de "$code" >/dev/null || code=fr
    [[ "$var" =~ ^[a-z0-9_]{0,20}$ ]] || var=""
  else
    # SoleOS installé avant le choix de la langue : français, clavier déjà réglé
    disp="$(sed -n 's/^XKBLAYOUT=//p' /etc/default/keyboard 2>/dev/null | tr -d '"' | cut -d, -f1)"
    var="$(sed -n 's/^XKBVARIANT=//p' /etc/default/keyboard 2>/dev/null | tr -d '"' | cut -d, -f1)"
  fi
  [[ "$disp" =~ ^[a-z]{2,8}$ ]] || disp=fr
  langue_ecrire "$code" "$disp" "$var"
}
# Options de la ligne de démarrage de l'outil de réparation (clé « live ») : même langue et clavier
options_langue_live() {
  local code=fr disp=fr var="" loc
  if [ -f "$FICHIER_LANGUE" ]; then
    code="$(sed -n 's/^LANGUE=//p' "$FICHIER_LANGUE" | tail -1)"
    disp="$(sed -n 's/^CLAVIER=//p' "$FICHIER_LANGUE" | tail -1)"
    var="$(sed -n 's/^VARIANTE=//p' "$FICHIER_LANGUE" | tail -1)"
  fi
  loc="$(locale_de "$code")" || { code=fr; loc=fr_FR.UTF-8; }
  printf 'locales=%s keyboard-layouts=%s%s flashos.langue=%s flashos.clavier=%s:%s' \
    "$loc" "${disp:-fr}" "${var:+ keyboard-variants=$var}" "$code" "${disp:-fr}" "$var"
}
# Réécrit le menu de démarrage avec les mêmes partitions (après un changement de langue)
regenerer_grub() {
  local cfg="$DEMARRAGE/grub/grub.cfg" ua ub uu cu
  [ -f "$cfg" ] || return 0
  ua="$(sed -n 's/.*root=UUID=\([^ ]*\) .*flashos\.slot=A.*/\1/p' "$cfg" | head -1)"
  ub="$(sed -n 's/.*root=UUID=\([^ ]*\) .*flashos\.slot=B.*/\1/p' "$cfg" | head -1)"
  uu="$(sed -n 's#.*live-media=/dev/disk/by-uuid/\([^ ]*\) .*#\1#p' "$cfg" | head -1)"
  cu="$(sed -n 's#.*live-media-path=/\([^ ]*\) .*#\1#p' "$cfg" | head -1)"
  [ -n "$ua" ] && [ -n "$ub" ] && [ -n "$uu" ] || return 0
  cp "$cfg" "$cfg.avant-langue"
  ecrire_grub "$DEMARRAGE/grub" "$ua" "$ub" "$uu" "${cu:-flashos-usine}"
  grep -q "$ua" "$cfg" || cp "$cfg.avant-langue" "$cfg"
  rm -f "$cfg.avant-langue"
}

etat() {
  local a; a="$(slot_actif)"
  echo "Emplacement en service : ${a:-aucun (pas un SoleOS installé)}"
  echo "Emplacement validé     : $(valeur_env saved_entry)"
  echo "Prochain démarrage     : $(valeur_env next_entry)"
  echo "Protection lecture seule : $(findmnt -no FSTYPE / 2>/dev/null)"
}

confirmer() {
  local a; a="$(slot_actif)"
  [ -n "$a" ] || exit 0
  [ "$(valeur_env saved_entry)" = "$a" ] && exit 0
  # Démarrage d'essai : on ne valide que si l'interface SoleOS a bien démarré
  if pgrep -x plasmashell >/dev/null || pgrep -x labwc >/dev/null || [ -n "${FLASHOS_CONFIRMER_SANS_INTERFACE:-}" ]; then
    grub-editenv "$ENV_GRUB" set "saved_entry=$a"
    rm -f "$ETAT/maj-prete"
    dire "Démarrage sur $a validé : la mise à jour est adoptée."
  else
    # Temps écoulé depuis l'ouverture des données (le temps passé à taper le code ne compte pas)
    local depuis ouverture; depuis="$(cut -d. -f1 /proc/uptime)"
    ouverture="$(cat "$ETAT/ouverture" 2>/dev/null || echo 0)"
    depuis=$((depuis - ouverture))
    if [ "$depuis" -ge "${FLASHOS_DELAI_ECHEC:-300}" ]; then
      # L'interface n'est jamais apparue : on redémarre sur la version précédente
      dire "Interface absente après ${depuis} s : la mise à jour sur $a est abandonnée, retour à la version précédente."
      systemctl reboot
    else
      dire "Interface pas encore prête sur $a (${depuis} s) : nouvelle vérification dans une minute."
    fi
  fi
}

preparer_reparation() {
  [ -f "$ENV_GRUB" ] || { echo "Menu de démarrage introuvable." >&2; exit 1; }
  grub-editenv "$ENV_GRUB" set next_entry=reparer
  echo "Au prochain démarrage : outil de réparation."
}

# Sur batterie, on ne prépare la mise à jour que si elle est chargée à 50 % ou plus
alimentation_suffisante() {
  local sys="${FLASHOS_SYS_ALIM:-/sys/class/power_supply}" d secteur=0 batterie=0 charge=100
  for d in "$sys"/*; do
    [ -f "$d/type" ] || continue
    case "$(cat "$d/type")" in
      Mains|USB|USB_C|USB_PD) [ "$(cat "$d/online" 2>/dev/null)" = 1 ] && secteur=1 ;;
      Battery)
        [ "$(cat "$d/scope" 2>/dev/null)" = Device ] && continue   # souris, clavier sans fil…
        batterie=1; c="$(cat "$d/capacity" 2>/dev/null || echo 100)"; [ "$c" -lt "$charge" ] && charge=$c ;;
    esac
  done
  [ "$secteur" = 1 ] || [ "$batterie" = 0 ] || [ "$charge" -ge 50 ]
}

# Listes de paquets et téléchargements : sur la partition des données, pas en mémoire
APT_DISQUE=/home/.flashos/apt
preparer_apt_disque() {
  mkdir -p "$APT_DISQUE/listes/partial" "$APT_DISQUE/paquets/partial" || return 1
  APT_OPTS=(-o "Dir::State::Lists=$APT_DISQUE/listes" -o "Dir::Cache::Archives=$APT_DISQUE/paquets")
}

# Applications ajoutées par l'utilisateur (Flatpak, dans son dossier personnel) :
# mises à jour directement, sans toucher au système
maj_applis() {
  command -v flatpak >/dev/null || return 0
  alimentation_suffisante || return 0
  local u d
  for d in /home/*/.local/share/flatpak; do
    [ -d "$d/app" ] || continue
    u="$(stat -c %U "$d")"
    [ -n "$u" ] && [ "$u" != root ] || continue
    dire "Mise à jour des applications de $u…"
    runuser -u "$u" -- env HOME="/home/$u" flatpak --user update -y --noninteractive >> "$JOURNAL_MAJ" 2>&1 \
      && dire "Applications de $u à jour." || dire "Mise à jour des applications de $u : échec (réessai plus tard)."
  done
}

nettoyer_maj() {
  mountpoint -q /run/flashos-maj/cible && umount -R -l /run/flashos-maj/cible
  mountpoint -q /run/flashos-maj/source && umount -l /run/flashos-maj/source
  true
}

maj() {
  local a b disque dev_a dev_b uuid_b n
  a="$(slot_actif)"; [ -n "$a" ] || { echo "Pas un SoleOS installé."; exit 0; }
  b="$(autre_slot "$a")"
  maj_applis
  if [ "$(valeur_env saved_entry)" != "$a" ]; then
    dire "Démarrage d'essai en cours sur $a : mise à jour reportée."; exit 0
  fi
  if [ -f "$ETAT/maj-prete" ]; then dire "Une mise à jour attend déjà le prochain démarrage."; exit 0; fi
  if ! alimentation_suffisante; then dire "Batterie sous 50 % : mise à jour reportée."; exit 0; fi
  exec 9>/run/flashos-maj.verrou; flock -n 9 || exit 0
  mkdir -p "$ETAT"
  APT_OPTS=(); preparer_apt_disque || APT_OPTS=()

  dire "Recherche de mises à jour…"
  apt-get "${APT_OPTS[@]}" update -qq >> "$JOURNAL_MAJ" 2>&1 || { dire "Pas de connexion aux serveurs de mise à jour."; exit 0; }
  n="$(apt-get "${APT_OPTS[@]}" -s dist-upgrade 2>/dev/null | grep -c '^Inst ')"
  if [ "$n" -eq 0 ] && [ -z "${FLASHOS_MAJ_FORCER:-}" ]; then dire "SoleOS est à jour."; exit 0; fi
  dire "$n paquet(s) à mettre à jour : préparation dans l'emplacement $b."

  disque="$(disque_systeme)"
  dev_a="$(partition_nommee "$disque" "FLASHOS-$a")"; dev_b="$(partition_nommee "$disque" "FLASHOS-$b")"
  [ -b "$dev_a" ] && [ -b "$dev_b" ] || { dire "Emplacements introuvables."; exit 1; }
  uuid_b="$(blkid -s UUID -o value "$dev_b")"
  trap nettoyer_maj EXIT
  mkdir -p /run/flashos-maj/source /run/flashos-maj/cible
  mount -o ro "$dev_a" /run/flashos-maj/source || { dire "Lecture du système impossible."; exit 1; }
  mkfs.ext4 -F -q -L "FlashOS-$b" ${uuid_b:+-U "$uuid_b"} "$dev_b" >> "$JOURNAL_MAJ" 2>&1 || { dire "Préparation de $b impossible."; exit 1; }
  mount "$dev_b" /run/flashos-maj/cible || exit 1
  rsync -aHAX --numeric-ids /run/flashos-maj/source/ /run/flashos-maj/cible/ >> "$JOURNAL_MAJ" 2>&1 \
    || { dire "Copie du système impossible."; exit 1; }
  umount /run/flashos-maj/source

  local c=/run/flashos-maj/cible
  for m in dev proc sys run; do mount --rbind "/$m" "$c/$m" && mount --make-rslave "$c/$m"; done
  # Accès Internet dans la copie : mêmes serveurs de noms que le système en cours
  local resolv; resolv="$(readlink -f /etc/resolv.conf)"
  if [ ! -L "$c/etc/resolv.conf" ] && [ -f "$resolv" ]; then
    touch "$c/etc/resolv.conf" && mount --bind "$resolv" "$c/etc/resolv.conf"
  fi
  # Mêmes listes et téléchargements que ci-dessus (rien à retélécharger, rien en mémoire)
  if [ ${#APT_OPTS[@]} -gt 0 ]; then
    mount --bind "$APT_DISQUE/listes" "$c/var/lib/apt/lists"
    mount --bind "$APT_DISQUE/paquets" "$c/var/cache/apt/archives"
  fi
  if ! chroot "$c" env DEBIAN_FRONTEND=noninteractive sh -c \
       'apt-get update -qq && apt-get -y -q -o Dpkg::Options::=--force-confold dist-upgrade && apt-get -y -q autoremove --purge && apt-get clean' \
       >> "$JOURNAL_MAJ" 2>&1; then
    dire "La mise à jour a échoué : rien n'est changé, SoleOS reste sur la version actuelle."; exit 1
  fi
  liens_noyau "$c" || { dire "Noyau introuvable après mise à jour."; exit 1; }
  # Système en lecture seule : on marque ici la mise à jour comme terminée
  # (sinon ldconfig et compagnie seraient relancés à chaque démarrage)
  touch "$c/etc/.updated" "$c/var/.updated"
  [ -f "$c/boot/initrd.img" ] || chroot "$c" update-initramfs -c -k "$(readlink "$c/boot/vmlinuz" | sed 's/vmlinuz-//')" >> "$JOURNAL_MAJ" 2>&1
  nettoyer_maj; trap - EXIT

  grub-editenv "$ENV_GRUB" set "next_entry=$b"
  touch "$ETAT/maj-prete"
  dire "Mise à jour prête : elle s'appliquera au prochain redémarrage."
}

# Imprimantes ajoutées : gardées dans la partition des données (le système est en lecture seule)
GARDE_IMPR=/home/.flashos/imprimantes
sauver_imprimantes() {
  [ -d /home/.flashos ] || exit 0
  mkdir -p "$GARDE_IMPR/ppd"; chmod 755 "$GARDE_IMPR"
  if [ -f /etc/cups/printers.conf ]; then cp -p /etc/cups/printers.conf "$GARDE_IMPR/printers.conf"; else rm -f "$GARDE_IMPR/printers.conf"; fi
  rsync -a --delete /etc/cups/ppd/ "$GARDE_IMPR/ppd/" 2>/dev/null || true
}
restaurer_imprimantes() {
  [ -f "$GARDE_IMPR/printers.conf" ] || exit 0
  install -m 600 -g lp "$GARDE_IMPR/printers.conf" /etc/cups/printers.conf 2>/dev/null \
    || cp "$GARDE_IMPR/printers.conf" /etc/cups/printers.conf
  mkdir -p /etc/cups/ppd
  [ -d "$GARDE_IMPR/ppd" ] && cp -a "$GARDE_IMPR/ppd/." /etc/cups/ppd/ 2>/dev/null
  true
}

# ---------------------------------------------------------------------
#  Date et heure (Réglages) : fuseau horaire, réglage automatique par Internet ou à la main.
#  Le système est en lecture seule : le choix est gardé sur la partition de démarrage et
#  réappliqué à chaque démarrage (heure-appliquer). L'heure elle-même reste dans l'horloge du PC.
# ---------------------------------------------------------------------
FICHIER_HEURE="$DEMARRAGE/flashos/heure"
noter_heure() {  # <clé> <valeur>
  [ -d "$DEMARRAGE" ] || return 0
  mkdir -p "$DEMARRAGE/flashos"; chmod 700 "$DEMARRAGE/flashos"
  touch "$FICHIER_HEURE"; chmod 600 "$FICHIER_HEURE"
  sed -i "/^$1=/d" "$FICHIER_HEURE"; echo "$1=$2" >> "$FICHIER_HEURE"
}
heure_etat() {
  echo "FUSEAU=$(timedatectl show -p Timezone --value 2>/dev/null)"
  echo "AUTO=$( [ "$(timedatectl show -p NTP --value 2>/dev/null)" = yes ] && echo oui || echo non)"
  echo "HEURE=$(date '+%Y-%m-%d %H:%M')"
}
heure_fuseau() {  # <Zone/Ville>
  local z="$1"
  [[ "$z" =~ ^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+){0,2}$ ]] && [ -f "/usr/share/zoneinfo/$z" ] \
    || { echo "Fuseau horaire inconnu." >&2; exit 1; }
  timedatectl set-timezone "$z" || exit 1
  echo "$z" > /etc/timezone 2>/dev/null
  noter_heure FUSEAU "$z"
}
heure_auto() {  # oui|non
  case "$1" in
    oui) systemctl unmask --runtime systemd-timesyncd.service >/dev/null 2>&1; timedatectl set-ntp true; noter_heure AUTO oui ;;
    non) timedatectl set-ntp false; noter_heure AUTO non ;;
    *) echo "oui ou non" >&2; exit 1 ;;
  esac
}
heure_regler() {  # « AAAA-MM-JJ HH:MM » (réglage manuel : coupe le réglage automatique)
  [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}$ ]] || { echo "Format : AAAA-MM-JJ HH:MM" >&2; exit 1; }
  date -d "$1" >/dev/null 2>&1 || { echo "Date impossible." >&2; exit 1; }
  timedatectl set-ntp false; noter_heure AUTO non
  timedatectl set-time "$1:00" || exit 1
}
heure_appliquer() {  # au démarrage
  [ -f "$FICHIER_HEURE" ] || return 0
  local z a
  z="$(sed -n 's/^FUSEAU=//p' "$FICHIER_HEURE" | tail -1)"
  a="$(sed -n 's/^AUTO=//p' "$FICHIER_HEURE" | tail -1)"
  if [ -n "$z" ] && [ -f "/usr/share/zoneinfo/$z" ]; then
    ln -sf "/usr/share/zoneinfo/$z" /etc/localtime; echo "$z" > /etc/timezone
  fi
  if [ "$a" = non ]; then
    systemctl mask --runtime systemd-timesyncd.service >/dev/null 2>&1
    systemctl stop --no-block systemd-timesyncd.service >/dev/null 2>&1
  fi
  true
}

case "${1:-}" in
  heure-etat) heure_etat ;;
  fuseau) heure_fuseau "${2:-}" ;;
  heure-auto) heure_auto "${2:-}" ;;
  heure-regler) heure_regler "${2:-}" ;;
  heure-appliquer) heure_appliquer ;;
  langue) langue_choisir "${2:-}" "${3:-}" "${4:-}" ;;
  langue-appliquer) langue_appliquer ;;
  etat) etat ;;
  maj) maj ;;
  confirmer) confirmer ;;
  preparer-reparation) preparer_reparation ;;
  ecrire-grub) ecrire_grub "$2" "$3" "$4" "$5" "${6:-}" ;;
  liens-noyau) liens_noyau "${2:-/}" ;;
  sauver-imprimantes) sauver_imprimantes ;;
  restaurer-imprimantes) restaurer_imprimantes ;;
  *) echo "Usage : $0 etat | maj | confirmer | preparer-reparation" >&2; exit 2 ;;
esac
