msgstr "El Wi-Fi está desactivado."

msgid "Aucun réseau trouvé à proximité."
msgstr "No se ha encontrado ninguna red cercana."

msgid "🔒"
msgstr "🔒"

msgid "Signal : {n}"
msgstr "Señal: {n}"

