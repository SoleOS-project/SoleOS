msgid "L'opération a échoué."
msgstr "La operación ha fallado."

msgid "Décrivez en une phrase ce qui ne marche pas. SoleOS prépare un message pour l'assistance, avec un relevé technique (sans mot de passe ni contenu personnel). Vous le relisez avant de l'envoyer."
msgstr "Describa en una frase lo que no funciona. SoleOS prepara un mensaje para el soporte, con un informe técnico (sin contraseñas ni contenido personal). Lo revisa antes de enviarlo."

msgid "Préparer le message"
msgstr "Preparar el mensaje"

msgid "Décrivez d'abord le problème en une phrase."
msgstr "Describa primero el problema en una frase."

msgid "Préparation du relevé et du message…"
msgstr "Preparando el informe y el mensaje…"

msgid "Le message est prêt dans Mail : relisez-le puis touchez « Envoyer ». Relevé joint : {f}"
msgstr "El mensaje está listo en Correo: revíselo y toque «Enviar». Informe adjunto: {f}"

msgid "Mail n'a pas pu s'ouvrir. Écrivez à {a} en joignant le fichier {f}."
msgstr "No se ha podido abrir Correo. Escriba a {a} adjuntando el archivo {f}."

msgid "{n} %"
msgstr "{n} %"

msgid "Le réseau ne répond pas. Réessayez plus près de la box."
msgstr "La red no responde. Vuelve a intentarlo más cerca del router."

msgid "Connexion impossible : {e}"
msgstr "No se puede conectar: {e}"

msgid "Aucun réseau de ce nom n'a répondu. Vérifiez le nom (majuscules comprises)."
msgstr "Ninguna red con ese nombre ha respondido. Compruebe el nombre (incluidas las mayúsculas)."

msgid "Se connecter"
msgstr "Conectar"

msgid "Réseau masqué…"
msgstr "Red oculta…"

msgid "Nom du réseau (SSID)"
msgstr "Nombre de la red (SSID)"

msgid "Mot de passe (vide si réseau ouvert)"
msgstr "Contraseña (vacía si la red es abierta)"

msgid "Chiffrement : automatique (conseillé)"
msgstr "Cifrado: automático (recomendado)"

msgid "WPA / WPA2 personnel"
msgstr "WPA / WPA2 personal"

msgid "WPA3 personnel"
msgstr "WPA3 personal"

msgid "Aucun (réseau ouvert)"
msgstr "Ninguno (red abierta)"

msgid "Réseau masqué : tapez son nom exact et son mot de passe."
msgstr "Red oculta: escriba su nombre exacto y su contraseña."

msgid "Activation du Wi-Fi…"
msgstr "Activando el Wi-Fi…"

msgid "Désactivation du Wi-Fi…"
msgstr "Desactivando el Wi-Fi…"

msgid "Ce chiffrement demande un mot de passe d'au moins 8 caractères."
msgstr "Este cifrado requiere una contraseña de al menos 8 caracteres."

msgid "Connexion à « {ssid} »…"
msgstr "Conectando con «{ssid}»…"

