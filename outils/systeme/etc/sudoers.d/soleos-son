# SoleOS : l'essai du son (Réglages → Son) règle la puce son ; le programme n'accepte que
# des numéros de recettes connues (voir /usr/local/sbin/soleos-son)
ALL ALL=(root) NOPASSWD: /usr/local/sbin/soleos-son etat, /usr/local/sbin/soleos-son essayer *, /usr/local/sbin/soleos-son annuler, /usr/local/sbin/soleos-son garder *, /usr/local/sbin/soleos-son oublier, /usr/local/sbin/soleos-son appliquer
