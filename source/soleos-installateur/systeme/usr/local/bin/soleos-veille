#!/bin/sh
# SoleOS : verrouillage automatique de l'écran.
# Délai en minutes dans ~/.config/soleos/verrouillage (0 = jamais ; 10 par défaut).
# Mise en veille (capot fermé…) : toujours verrouillé avant.
m="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/soleos/verrouillage" 2>/dev/null || echo 10)"
case "$m" in ''|*[!0-9]*) m=10 ;; esac
if [ "$m" -gt 0 ]; then
  exec swayidle -w timeout $((m * 60)) soleos-verrouiller before-sleep soleos-verrouiller
fi
exec swayidle -w before-sleep soleos-verrouiller
