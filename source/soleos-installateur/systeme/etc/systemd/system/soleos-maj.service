[Unit]
Description=SoleOS : préparation des mises à jour (en arrière-plan)
ConditionKernelCommandLine=soleos.slot
Wants=network-online.target
After=network-online.target soleos-confirmer.service
RequiresMountsFor=/soleos/demarrage

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
ExecStart=/usr/local/sbin/soleos-systeme maj
